# Copy to .env and fill secrets. Never commit real .env.

DB_HOST="host_name"
DB_NAME="DB_Name"
DB_USER="User_Name"
DB_PASSWORD=""
DB_SCHEMA=rico

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000

# IoT sync — runs inside FastAPI (tab closed = still works)
# Boot default only when no UI preference saved yet.
# Plant admins can Start/Stop from Monitor or Admin UI (/api/iot/*).
IOT_SYNC_ENABLED=false
IOT_SYNC_INTERVAL_SECONDS=60
IOT_SYNC_INCLUDE_LEGACY=false

IOT_BASE_URL=""
IOT_DATA_BASE_URL=""
IOT_USERNAME=
IOT_PASSWORD=
IOT_MACHINE_IP=""
IOT_AUTH_TIMEOUT=15
IOT_DATA_TIMEOUT=30
