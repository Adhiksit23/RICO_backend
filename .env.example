# Copy to .env and fill secrets. Never commit real .env.

DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SCHEMA=rico

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000

# IoT sync — runs inside FastAPI (tab closed = still works)
# Boot default only when no UI preference saved yet.
# Plant admins can Start/Stop from Monitor or Admin UI (/api/iot/*).
IOT_SYNC_ENABLED=false
IOT_SYNC_INTERVAL_SECONDS=60
IOT_SYNC_INCLUDE_LEGACY=false

IOT_BASE_URL=http://14.195.222.243:9090/api
IOT_DATA_BASE_URL=http://14.195.222.243/api
IOT_USERNAME=
IOT_PASSWORD=
IOT_MACHINE_IP=192.168.117.201
IOT_AUTH_TIMEOUT=15
IOT_DATA_TIMEOUT=30
